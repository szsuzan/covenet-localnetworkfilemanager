[Unit]
Description=CoveNet internal file share
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cove
Environment=NODE_ENV=production
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node %h/cove/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
