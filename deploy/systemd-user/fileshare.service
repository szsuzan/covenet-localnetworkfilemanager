[Unit]
Description=Cove internal file share
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cove/cove
Environment=NODE_ENV=production
Environment=PATH=/home/cove/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /home/cove/cove/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
