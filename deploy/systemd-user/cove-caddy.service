[Unit]
Description=CoveNet TLS proxy
After=network-online.target fileshare.service
Wants=network-online.target fileshare.service

[Service]
Type=simple
WorkingDirectory=%h/cove
ExecStart=%h/.local/bin/caddy run --config deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
