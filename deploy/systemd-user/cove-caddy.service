[Unit]
Description=Cove TLS proxy
After=network-online.target fileshare.service
Wants=network-online.target fileshare.service

[Service]
Type=simple
ExecStart=/home/cove/.local/bin/caddy run --config /home/cove/cove/deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
