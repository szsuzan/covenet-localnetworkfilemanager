[Unit]
Description=Cove single-port TLS/HTTP multiplexer
After=network-online.target cove-caddy.service
Wants=network-online.target
Requires=cove-caddy.service

[Service]
Type=simple
Environment=PATH=/home/cove/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MUX_PORT=3000
Environment=MUX_TLS_PORT=3443
ExecStart=/usr/bin/env node /home/cove/cove/scripts/mux.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
