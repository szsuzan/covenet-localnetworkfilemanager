STORAGE_ROOT=/srv/cove/files
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 1 behind the Caddy TLS proxy; use 0 only for local HTTP dev.
COOKIE_SECURE=1
SESSION_IDLE_DAYS=7
MAX_UPLOAD_GB=200

# Background limits
TRANSCODE_CONCURRENCY=2
THUMB_CONCURRENCY_IMAGES=4
THUMB_CONCURRENCY_VIDEOS=2

# Cleanup (hours unless noted)
UPLOAD_STALE_HOURS=24
TRASH_RETENTION_DAYS=30
HLS_RETENTION_DAYS=7
HLS_MAX_GB=10
THUMB_RETENTION_DAYS=90
THUMB_MAX_GB=2
CLEANUP_INTERVAL_HOURS=6
# 1 only behind Caddy, which overwrites X-Forwarded-For.
TRUST_PROXY=1
